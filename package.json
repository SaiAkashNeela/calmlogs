{
  "name": "calmlogs",
  "version": "0.1.0",
  "description": "Lightweight, zero-friction live log streaming CLI and platform",
  "type": "module",
  "main": "bin/calmlogs.js",
  "bin": {
    "calmlogs": "bin/calmlogs.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "author": "Sai Akash Neela",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiakashneela/calmlogs.git"
  },
  "keywords": [
    "logging",
    "logs",
    "docker",
    "calmlogs",
    "cli",
    "streaming",
    "realtime"
  ],
  "scripts": {
    "dev": "npm run wrangler:dev & tsx server.ts",
    "wrangler:dev": "npx --yes kill-port 8787 && wrangler dev --port 8787",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "bun run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "better-auth": "^1.7.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "lucide-react": "^1.45.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.2",
    "autoprefixer": "^10.5.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.12",
    "http-proxy-middleware": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "wrangler": "^4.131.1"
  }
}
